#!/usr/bin/env bash
# The CI stand-in for wslc.exe (E1.S2 decision 12). Answers are scripted by the test through files below $R9700_STUB_DIR; see
# stub_common.sh. Output has CRLF line ends, like a Windows executable.
set -u
# shellcheck source=tests/stubs/stub_common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/stub_common.sh"
stub_log wslc "$@"
stub_mode_if_asked

CRLF=$'\r'
# shellcheck source=tests/stubs/stub_bench.sh
source "$STUB_HERE/stub_bench.sh"

# ---- the MoE foreground runs (E2.S2 decision 9) -----------------------------------------------------------------------------------------------
# moe_kind <argv...>: sets MOE_KIND to `bench` (a benchmark_moe.py run: `--tune` is a chunk, else a kernel A/B container), `linear` (a linear_bench.py
# run, E3.S1: the kernels worker's foreground container), `clear` (the cache-clear
# program: `sh -c` with a program that names triton-moe-tune) or "" and returns 1 when the run is none of them (the fingerprint's throwaway run).
moe_kind() {
  local arg prev=""
  MOE_KIND=""
  for arg in "$@"; do
    [ "$arg" = benchmark_moe.py ] && MOE_KIND=bench
    [[ $arg == */linear_bench.py ]] && MOE_KIND=linear
    [ "$prev" = -c ] && [[ $arg == *triton-moe-tune* ]] && MOE_KIND=clear
    prev="$arg"
  done
  [ -n "$MOE_KIND" ]
}

# moe_foreground <name> <argv...>: the container of a foreground `run --rm --name <name>`. Like a detached one it is a recorded process
# (containers/<name>.pid, here the stub's own pid) for its duration, so `wslc list` shows it and `wslc stop <name>` ends it (UNVERIFIED for the real
# wslc: nobody has observed whether a foreground run is listed). The record goes at the stub's end, however it ends. Every answer file is read from
# $R9700_STUB_DIR only:
#   answers/moe_tune_seconds, moe_tune_rc, moe_tune_log   a chunk (`--tune`): sleeps, writes every file of the folder answers/moe_json/ into the
#       save dir (the path /work/ read as $R9700_WORK_DIR/; no folder: nothing is written, the half-written chunk), prints the log, exits with the rc
#   answers/moe_ab_seconds, moe_ab.<arm>[.<rep>]          a kernel A/B container (the arm is the word after `moe-ab-` in the name, the rep its number): sleeps, prints
#   answers/moe_cache                                     the clear: prints it (default one `du` line)
#   answers/fault.<name>                                  a chunk, A/B or linear container: exits with the code in the file (once) and stays listed (foreground_fault)
moe_foreground() {
  local name="$1" file="$R9700_STUB_DIR/containers/$1.pid"
  shift
  if stub_alive "$file"; then echo "stub: container name in use: $name" >&2; exit 1; fi
  stub_record_pid "$file" "$$"
  MOE_PIDFILE="$file"
  trap 'rm -f "$MOE_PIDFILE"; [ -z "${MOE_SLEEPER:-}" ] || kill "$MOE_SLEEPER" 2> /dev/null' EXIT
  trap 'exit 143' TERM
  # on-start-<name>: a script of the test, run once that container has started (E2.S2: the way a test arms a fault for the calls that come AFTER a
  # unit's container started, like the cleanup hook's clear, however that container ends: stopped by name, killed with its session, or cut by its ceiling)
  [ -f "$R9700_STUB_DIR/on-start-$name" ] && bash "$R9700_STUB_DIR/on-start-$name"
  if [ "$MOE_KIND" = clear ] && [ -f "$R9700_STUB_DIR/moe_clear_mode" ]; then stub_mode_apply "$(cat "$R9700_STUB_DIR/moe_clear_mode")"; fi
  if [ "$MOE_KIND" = clear ]; then
    if [ -f "$R9700_STUB_DIR/answers/moe_cache" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/moe_cache"; else printf '1.3G\t/root/.cache/vllm/triton-moe-tune%s\n' "$CRLF"; fi
    return "$(moe_answer moe_clear_rc 0)" # answers/moe_clear_rc: the exit code of the clear container (default 0)
  fi
  local rc
  if [ "$MOE_KIND" = linear ]; then linear_bench "$name" "$@"; rc=$?; else moe_bench "$name" "$@"; rc=$?; fi
  foreground_fault "$name" rc
  return "$rc"
}

# foreground_fault <name> <rc variable>: answers/fault.<name> holds an exit code (a ceiling that cut the call: 124): the foreground run returns it AND leaves its
# container running and listed, as a `wslc run` cut by the adapter's ceiling can; the file is used once, so a retry starts clean (E3.S1 review)
foreground_fault() {
  local file="$R9700_STUB_DIR/answers/fault.$1"
  [ -f "$file" ] || return 0
  printf -v "$2" '%s' "$(head -n 1 "$file")"
  rm -f "$file"
  MOE_PIDFILE=/nonexistent/none # the exit trap must not remove the record of the container that stays
  stub_container_start "$1"
}

# linear_bench <name> <argv...>: a linear_bench.py container (E3.S1). Every answer file is read from $R9700_STUB_DIR only; the stub never runs a program:
#   answers/linear_seconds   how long the container runs (default 0)
#   answers/linear           a file: copied to the path of `--out` (a path under /work, which is $R9700_WORK_DIR here); without it nothing is written
#   answers/linear.log       the container's output (default one line)
#   answers/linear_rc        the exit code (default 0)
linear_bench() {
  local arg prev="" out=""
  shift
  for arg in "$@"; do
    [ "$prev" = --out ] && out="$arg"
    prev="$arg"
  done
  sleep "$(moe_answer linear_seconds 0)" < /dev/null > /dev/null 2>&1 &
  MOE_SLEEPER=$!
  wait "$MOE_SLEEPER"
  if [ -f "$R9700_STUB_DIR/answers/linear" ] && [ -n "$out" ]; then cp "$R9700_STUB_DIR/answers/linear" "${R9700_WORK_DIR:?}/${out#/work/}"; fi
  if [ -f "$R9700_STUB_DIR/answers/linear.log" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/linear.log"; else printf 'stub linear bench%s\n' "$CRLF"; fi
  return "$(moe_answer linear_rc 0)"
}

# prefix_call <name> python3 <script> run <url> <model> <tag> ... (the first word is the container's name): what prefixtest.py would print (E3.S1): answers/prefix with its first word replaced by the asked
# tag, else the two recorded lines of fcombo-1 (results § 13.3). answers/prefix_rc is the exit code; R9700_STUB_DELAY_S holds the call first.
prefix_call() {
  local tag="${7:-t}"
  [ -n "${R9700_STUB_DELAY_S:-}" ] && sleep "$R9700_STUB_DELAY_S"
  if [ -f "$R9700_STUB_DIR/answers/prefix" ]; then sed -e "s/^[^ ]* /$tag /" -e "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/prefix"
  else
    printf '%s prefixtest len=8192 A cold=2.1s A hit=0.5s A hit=0.51s B cold=2.15s B hit=0.48s A partial=0.49s%s\n' "$tag" "$CRLF"
    printf '%s prefixtest len=1024 A cold=0.22s A hit=0.22s A hit=0.2s B cold=0.19s B hit=0.2s A partial=0.19s%s\n' "$tag" "$CRLF"
  fi
  return "$(moe_answer prefix_rc 0)"
}

# moe_answer <file name> <default>: the content of answers/<file name> (first line), else the default
moe_answer() {
  if [ -f "$R9700_STUB_DIR/answers/$1" ]; then head -n 1 "$R9700_STUB_DIR/answers/$1"; else printf '%s\n' "$2"; fi
}

# moe_bench <name> <argv...>: a chunk or a kernel A/B container (see the answers above)
moe_bench() {
  local name="$1" arg prev="" tune=no save="" arm rep keys=() collecting=no seconds rc
  shift
  for arg in "$@"; do
    [ "$arg" = --tune ] && tune=yes
    [ "$prev" = --save-dir ] && save="$arg"
    if [[ $arg == --* ]]; then collecting=no; fi
    [ "$collecting" = yes ] && keys+=("$arg")
    [ "$arg" = --batch-size ] && collecting=yes
    prev="$arg"
  done
  if [ "$tune" = yes ]; then seconds="$(moe_answer moe_tune_seconds 0)"; else seconds="$(moe_answer moe_ab_seconds 0)"; fi
  sleep "$seconds" < /dev/null > /dev/null 2>&1 &
  MOE_SLEEPER=$!
  wait "$MOE_SLEEPER"
  if [ "$tune" = yes ]; then
    if [ -d "$R9700_STUB_DIR/answers/moe_json" ]; then cp "$R9700_STUB_DIR"/answers/moe_json/* "${R9700_WORK_DIR:?}/${save#/work/}/"; fi
    if [ -f "$R9700_STUB_DIR/answers/moe_tune_log" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/moe_tune_log"
    else
      printf 'Start tuning over 3 configurations%s\nTuning space has 3 configs%s\n' "$CRLF" "$CRLF"
      printf 'Completed tuning for batch_size=%s%s\n' "${keys[0]:-0}" "$CRLF"
    fi
    rc="$(moe_answer moe_tune_rc 0)"
    return "$rc"
  fi
  arm="${name##*moe-ab-}"
  rep="${arm##*-}"
  arm="${arm%-*}"
  # answers/moe_ab.<arm>.<rep> (one log per rep, so a table of three different medians can be served), else answers/moe_ab.<arm>
  if [ -f "$R9700_STUB_DIR/answers/moe_ab.$arm.$rep" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/moe_ab.$arm.$rep"
  elif [ -f "$R9700_STUB_DIR/answers/moe_ab.$arm" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/moe_ab.$arm"; fi
  return 0
}

# comfy_check_is <argv...>: 0 when the foreground run is the throwaway container of `comfy build` (E1.S3): `--entrypoint python3 ... -c <program>` where the program names torch.version.hip
comfy_check_is() {
  local arg prev="" entry=no program=""
  for arg in "$@"; do
    [ "$prev" = --entrypoint ] && [ "$arg" = python3 ] && entry=yes
    [ "$prev" = -c ] && program="$arg"
    prev="$arg"
  done
  [ "$entry" = yes ] && [[ $program == *torch.version.hip* ]]
}

# comfy_check_answer: prints answers/comfy_check with CRLF ends (default the four lines of an R9700) and returns answers/comfy_check_rc (default 0)
comfy_check_answer() {
  if [ -f "$R9700_STUB_DIR/answers/comfy_check" ]; then
    sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/comfy_check"
  else
    printf 'torch 2.13.0+rocm10.1.0%s\nhip 10.1.0%s\ndevice AMD Radeon AI PRO R9700%s\nmatmul ok%s\n' "$CRLF" "$CRLF" "$CRLF" "$CRLF"
  fi
  return "$(moe_answer comfy_check_rc 0)"
}

# fetch_foreground <name>: the container of `comfy fetch` (E1.S3): a foreground `run --rm --name <name> ... /work/r9700/comfyui/fetch_model.sh <triples>`. It is a recorded process
# (containers/<name>.pid = the stub's own pid, removed when the stub ends, however it ends: the shape of moe_foreground) for as long as it sleeps, so `wslc list` shows it; a live
# record of the name refuses a second run with the engine's reason. The sleep is answers/comfy_fetch_seconds (default 0; a ceiling or a TERM ends it), then answers/comfy_fetch.log
# is printed (default one `stub fetch` line, CRLF ends) and the code is answers/comfy_fetch_rc (default 0). A KILL of the process that started the stub leaves the stub, and so
# the record, alive until its own sleep ends: the engine's container does not die with its client.
fetch_foreground() {
  local name="$1" file="$R9700_STUB_DIR/containers/$1.pid"
  if stub_alive "$file"; then echo "stub: container name in use: $name" >&2; exit 1; fi
  stub_record_pid "$file" "$$"
  MOE_PIDFILE="$file"
  trap 'rm -f "$MOE_PIDFILE"; [ -z "${MOE_SLEEPER:-}" ] || kill "$MOE_SLEEPER" 2> /dev/null' EXIT
  trap 'exit 143' TERM
  sleep "$(moe_answer comfy_fetch_seconds 0)" < /dev/null > /dev/null 2>&1 &
  MOE_SLEEPER=$!
  wait "$MOE_SLEEPER"
  if [ -f "$R9700_STUB_DIR/answers/comfy_fetch.log" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/comfy_fetch.log"; else printf 'stub fetch%s\n' "$CRLF"; fi
  return "$(moe_answer comfy_fetch_rc 0)"
}

# run -d --rm --name X ...: a detached container; prints three lines. `run --rm ...` WITHOUT -d is a foreground run (E1.S3: the throwaway
# container of the fingerprint): it starts nothing and prints answers/find, a `---` line and answers/genconfig (a missing file prints nothing).
run_container() {
  local name="" prev="" detached=no
  for arg in "$@"; do
    [ "$prev" = --name ] && name="$arg"
    [ "$arg" = -d ] && detached=yes
    prev="$arg"
  done
  if [ "$detached" = no ] && moe_kind "$@"; then
    moe_foreground "$name" "$@"
    return $?
  fi
  if [ "$detached" = no ] && comfy_check_is "$@"; then
    comfy_check_answer
    return $?
  fi
  if [ "$detached" = no ] && [[ " $* " == *"/fetch_model.sh "* ]]; then
    fetch_foreground "$name"
    return $?
  fi
  # the throwaway containers of a ComfyUI arm-round (E2.S2): the cache clear, the cache report, the model listing
  if [ "$detached" = no ] && comfy_clear_is "$@"; then comfy_clear_answer; return $?; fi
  if [ "$detached" = no ] && comfy_report_is "$@"; then comfy_report_answer; return $?; fi
  if [ "$detached" = no ] && comfy_listing_is "$@"; then
    comfy_listing_answer "${COMFY_REST[@]}"
    return $?
  fi
  if [ "$detached" = no ]; then
    [ -f "$R9700_STUB_DIR/hang-foreground-run" ] && stub_hang # a throwaway container that never answers (the caller's ceiling ends it)
    [ -f "$R9700_STUB_DIR/answers/find" ] && sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/find"
    printf -- '---%s\n' "$CRLF"
    [ -f "$R9700_STUB_DIR/answers/genconfig" ] && sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/genconfig"
    return 0
  fi
  if [ -z "$name" ]; then
    echo "stub: run without --name" >&2
    exit 2
  fi
  # stopped/<name>: a stopped container keeps its name, as the real engine's does until `remove` (E1.S2: the hand-made start script needed a remove before every start)
  if [ -f "$R9700_STUB_DIR/stopped/$name" ]; then
    echo "stub: container name in use (a stopped container): $name" >&2
    exit 1
  fi
  if stub_alive "$R9700_STUB_DIR/containers/$name.pid"; then
    echo "stub: container name in use: $name" >&2 # the live record is never overwritten
    exit 1
  fi
  stub_container_start "$name"
  rm -f "$R9700_STUB_DIR/logs.d/$name" # a new container of a name starts a new log (E2.S2: what the bench runs of the earlier one added is not its)
  # on-start-<name> (E2.S2): a script of the test, run once the detached container is listed (the moment a bench container starts)
  [ -f "$R9700_STUB_DIR/on-start-$name" ] && bash "$R9700_STUB_DIR/on-start-$name"
  # The engine's half is done here (the container is real and listed); the client's half is what these two files script (E1.S2: the call can time out, fail or be cut
  # after the container exists). run-delay-<name>: seconds, READ and not removed, slept before the three lines; run-fail-<name>: a count, then the client fails.
  if [ -f "$R9700_STUB_DIR/run-delay-$name" ]; then sleep "$(cat "$R9700_STUB_DIR/run-delay-$name")"; fi
  if [ -f "$R9700_STUB_DIR/run-fail-$name" ]; then
    read -r _left < "$R9700_STUB_DIR/run-fail-$name"
    if [ "${_left:-0}" -gt 0 ]; then
      printf '%s\n' "$((_left - 1))" > "$R9700_STUB_DIR/run-fail-$name"
      echo "stub: run: the client failed after the container started (scripted): $name" >&2
      exit 1
    fi
  fi
  printf 'stub-line-1%s\nstub-line-2%s\nstub-line-3 %s%s\n' "$CRLF" "$CRLF" "$name" "$CRLF"
}

# <stub dir>/fail-list: "<count>" or "<skip> <count>": after <skip> good `list` calls (default 0) the next <count> calls fail (a transient fault of wslc)
list_containers() {
  local file skip=0 count=0 delay
  # list-delay-once: this call sleeps that many seconds, and removes the file first, so that no other call (a retry, a second list at the same moment) is delayed too
  if [ -f "$R9700_STUB_DIR/list-delay-once" ]; then
    delay="$(cat "$R9700_STUB_DIR/list-delay-once")"
    rm -f "$R9700_STUB_DIR/list-delay-once"
    sleep "$delay"
  fi
  # list-delay-until-<name>: seconds EVERY `wslc list` sleeps while no container <name> is running (the delayed call is noted in list-delayed.log: "<epoch.ns> <seconds>").
  # The restore's preparation lists come before the start of the operator's server and ready_wait's after it, so a test can slow the first group and leave the second alone.
  for file in "$R9700_STUB_DIR"/list-delay-until-*; do
    [ -f "$file" ] || continue
    stub_alive "$R9700_STUB_DIR/containers/${file##*/list-delay-until-}.pid" && continue
    delay="$(cat "$file")"
    printf '%s %s\n' "$(date +%s.%N)" "$delay" >> "$R9700_STUB_DIR/list-delayed.log"
    sleep "$delay"
  done
  # hang-list: a number n; the n-th `list` call counted from the file's making hangs like `mode` would (the recorded sleeper, the caller's ceiling ends it); the others answer
  if [ -f "$R9700_STUB_DIR/hang-list" ] && [ "$(stub_next list-hang)" = "$(head -n 1 "$R9700_STUB_DIR/hang-list")" ]; then stub_hang; fi
  if [ -f "$R9700_STUB_DIR/fail-list" ]; then
    read -r skip count < "$R9700_STUB_DIR/fail-list"
    if [ -z "$count" ]; then count="$skip"; skip=0; fi
    if [ "${skip:-0}" -gt 0 ]; then
      printf '%s %s\n' "$((skip - 1))" "$count" > "$R9700_STUB_DIR/fail-list"
    elif [ "${count:-0}" -gt 0 ]; then
      printf '0 %s\n' "$((count - 1))" > "$R9700_STUB_DIR/fail-list"
      echo "stub: wslc list failed (scripted)" >&2
      exit 1
    fi
  fi
  printf 'CONTAINER ID  NAME%s\n' "$CRLF"
  for file in "$R9700_STUB_DIR"/containers/*.pid; do
    [ -e "$file" ] || continue
    stub_alive "$file" || continue
    printf '0123abcd4567  %s%s\n' "$(basename "$file" .pid)" "$CRLF"
  done
}

# exec <name> <cmd...>: vllm bench serve prints its metric lines of the answers/bench file; a python urlopen program answers from
# answers/ready (answers/ready.<name> first, E1.S3: one container can be made to fail) or, for /metrics, from answers/metrics; the harness
# of the quality step writes its result file; anything else succeeds silently.
#   answers/bench, legacy form: lines WITHOUT a group, three per block; the block of the call is (c == 1 ? 0 : 3) + seed - 1, and a block that
#       is not there repeats the last one. A prefill call (--random-output-len 128) takes block 6 + 3 * <position of its length in
#       R9700_PREFILL_LENS> + seed - 1.
#   answers/bench, tagged form (the first line starts `c=<n> r=<n> ` or `prefill<n> r=<n> `): the lines of the asked group and seed with the
#       group cut off; a line that is not there stays missing (a measurement the server did not print). Decode: group c=<c>; prefill: group
#       prefill<--random-input-len>.
#   R9700_STUB_DELAY_S: every `bench serve` call sleeps that long first (a measurement that takes time).
bench_lines() {
  local c="$1" seed="$2" len="$3" outlen="$4" file="$R9700_STUB_DIR/answers/bench" first group idx pos=0 n word
  [ -f "$file" ] || return 0
  first="$(head -n 1 "$file")"
  if [ "$outlen" = 128 ]; then group="prefill$len"; else group="c=$c"; fi
  if [[ $first =~ ^(c=[0-9]+|prefill[0-9]+)\ r=[0-9]+\  ]]; then
    awk -v g="$group r=$seed " -v crlf="$CRLF" 'index($0, g) == 1 { printf "%s%s\n", substr($0, length(g) + 1), crlf }' "$file"
    return 0
  fi
  if [ "$outlen" = 128 ]; then
    for word in ${R9700_PREFILL_LENS:-}; do [ "$word" = "$len" ] && break; pos=$((pos + 1)); done
    idx=$((6 + 3 * pos + seed - 1))
  else
    idx=$(((c == 1 ? 0 : 3) + seed - 1))
  fi
  awk -v idx="$idx" -v crlf="$CRLF" '{ line[NR] = $0 } END { b = idx; if (3 * b + 3 > NR) b = int((NR - 1) / 3); for (i = 3 * b + 1; i <= 3 * b + 3 && i <= NR; i++) printf "%s%s\n", line[i], crlf }' "$file"
}

# harness_call <script> <sub command> <argv...>: what the container's lib/harness.py would do, minus the server: the file of --out (a path under
# /work, which is $R9700_WORK_DIR here) is written with the shape the record check reads (collect: answers/prompts_n results, default 20; gsm8k:
# n 200 with the stderr the verdict recomputes). The real one does not make the folder either.
harness_call() {
  local sub="$2" out="" prev="" arg real
  shift 2
  for arg in "$@"; do
    [ "$prev" = --out ] && out="$arg"
    prev="$arg"
  done
  [ -n "$out" ] || { echo "stub: harness call without --out" >&2; return 2; }
  real="${R9700_WORK_DIR:?R9700_WORK_DIR is not set}/${out#/work/}"
  [ -d "$(dirname "$real")" ] || { echo "FileNotFoundError: $(dirname "$out")" >&2; return 1; }
  case $sub in
    collect) python3 -c 'import json, sys; json.dump({"results": [{"prompt": str(i)} for i in range(int(sys.argv[2]))]}, open(sys.argv[1] + ".part", "w"))' "$real" "$(cat "$R9700_STUB_DIR/answers/prompts_n" 2> /dev/null || echo 20)" ;;
    gsm8k) python3 -c 'import json, math, sys; p = 0.85; json.dump({"summary": {"n": 200, "correct": 170, "accuracy": p, "stderr": math.sqrt(p * (1 - p) / 200)}, "items": []}, open(sys.argv[1] + ".part", "w"))' "$real" ;;
    *) echo "stub: harness: unknown sub command $sub" >&2; return 2 ;;
  esac
  mv "$real.part" "$real"
  echo "wrote $out"
}

exec_in() {
  local name="$1" arg prev="" c="" seed="" len="" outlen="" word
  shift
  if [ "${1:-}" = vllm ] && [ "${2:-}" = bench ] && [ "${3:-}" = serve ]; then
    for arg in "$@"; do
      [ "$prev" = --max-concurrency ] && c="$arg"
      [ "$prev" = --seed ] && seed="$arg"
      [ "$prev" = --random-input-len ] && len="$arg"
      [ "$prev" = --random-output-len ] && outlen="$arg"
      prev="$arg"
    done
    [ -n "${R9700_STUB_DELAY_S:-}" ] && sleep "$R9700_STUB_DELAY_S"
    bench_lines "$c" "$seed" "$len" "$outlen"
  elif comfy_bench_is "$@"; then
    comfy_bench_call "$name" "$@" # E2.S2: the exec of comfyui/bench.py, answered from scripted files
  elif comfy_clean_stop_is "$@"; then
    comfy_clean_stop "$name"
  elif [ "${1:-}" = python3 ] && [[ ${2:-} == */prefixtest.py ]]; then
    prefix_call "$name" "$@"
  elif [ "${1:-}" = python3 ] && [[ ${2:-} == */harness.py ]]; then
    harness_call "$2" "${3:-}" "${@:4}"
  elif [ "${1:-}" = python3 ] && [ "${2:-}" = -c ] && [[ ${3:-} == *system_stats* ]]; then
    # the ComfyUI readiness probe (E1.S2): answers/comfy_ready, call k takes line k, the last repeats; ok | fail | hang
    word="$(stub_answer comfy_ready)" || exit 99 # the file is missing: the test scripted nothing (stub_answer exits in its own subshell only)
    [ "$word" = hang ] && stub_hang
    if [ "$word" = ok ]; then
      comfy_ready_ok
    else
      printf 'system_stats: URLError%s\n' "$CRLF"
      return 1
    fi
  elif [ "${1:-}" = python3 ] && [ "${2:-}" = -c ] && [[ ${3:-} == *urlopen*/metrics* ]]; then
    [ -f "$R9700_STUB_DIR/answers/metrics" ] && sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/metrics"
    return 0
  elif [ "${1:-}" = python3 ] && [ "${2:-}" = -c ] && [[ ${3:-} == *urlopen* ]]; then
    if [ -f "$R9700_STUB_DIR/answers/ready.$name" ]; then word="$(stub_answer "ready.$name")"; else word="$(stub_answer ready)"; fi
    [ "$word" = hang ] && stub_hang # a probe that never answers (the caller's ceiling ends it)
    if [[ $3 == */v1/completions* ]]; then
      case $word in
        ok) printf 'models%s\ncompletion%s\n' "$CRLF" "$CRLF" ;;
        models-only) printf 'models%s\ncompletion: HTTP 500%s\n' "$CRLF" "$CRLF"; return 1 ;;
        *) printf 'models: <urlopen error>%s\n' "$CRLF"; return 1 ;;
      esac
    else
      case $word in ok | models-only) return 0 ;; *) return 1 ;; esac
    fi
  fi
}

# build <argv...> (E1.S1: wslc build -t <tag> -f <file> <context>): the image build of the comfy verb. Every answer file is read from $R9700_STUB_DIR only:
#   answers/build_seconds   how long the build runs (default 0); the sleeper is ended with the stub, so a ceiling ends it
#   answers/build.log       the build's output, printed with CRLF ends (default three lines `stub build line <n>`)
#   answers/build_rc        the exit code (default 0)
#   answers/build_id        (E1.S3) the id the built image gets (default: `sha256:` and the call counter zero-padded to 64 digits, distinct per call)
#   answers/build_tags_on_failure   (E1.S3) 1: a failing build still records its tag (the engine tagged before it failed)
# With a `-t <ref>` word pair the build records `<repository> <tag> <id>` in the file images (a build of a tag that exists moves the record: the old image is left untagged).
build_image() {
  local arg prev="" ref="" rc id
  trap '[ -z "${MOE_SLEEPER:-}" ] || kill "$MOE_SLEEPER" 2> /dev/null' EXIT
  trap 'exit 143' TERM
  for arg in "$@"; do
    [ "$prev" = -t ] && ref="$arg"
    prev="$arg"
  done
  sleep "$(moe_answer build_seconds 0)" < /dev/null > /dev/null 2>&1 &
  MOE_SLEEPER=$!
  wait "$MOE_SLEEPER"
  if [ -f "$R9700_STUB_DIR/answers/build.log" ]; then
    sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/build.log"
  else
    printf 'stub build line %s%s\n' 1 "$CRLF" 2 "$CRLF" 3 "$CRLF"
  fi
  rc="$(moe_answer build_rc 0)"
  if [ -n "$ref" ] && { [ "$rc" = 0 ] || [ "$(moe_answer build_tags_on_failure 0)" = 1 ]; }; then
    id="$(moe_answer build_id "sha256:$(printf '%064d' "$(cat "$R9700_STUB_DIR/counters/calls")")")"
    image_set "${ref%:*}" "${ref##*:}" "$id"
  fi
  return "$rc"
}

# ---- the images (E1.S3) -------------------------------------------------------------------------------------------------------------------------
# The file $R9700_STUB_DIR/images holds one record `<repository> <tag> <id>` per tagged image (id: `sha256:` and 64 hex); a test plants records by writing it.
#   answers/tag_rc, answers/rmi_rc   a non-zero code: `tag` / `rmi` fails with it (one `stub:` line) and changes nothing
#   answers/tag_after_rc             a non-zero code: `tag` MOVES the tag and then fails with it (one `stub:` line)
#   answers/image_list               printed by `image list` instead of the table (CRLF ends added)
#   fail-image-list                  the counting shape of fail-list: "<count>" or "<skip> <count>"; the failing calls print one `stub:` line and exit 1

# image_set <repository> <tag> <id>: sets the record of <repository>:<tag> (in place when it exists, else at the end)
image_set() {
  local file="$R9700_STUB_DIR/images"
  (
    flock 8
    if [ -f "$file" ] && awk -v r="$1" -v t="$2" '$1 == r && $2 == t { f = 1 } END { exit !f }' "$file"; then
      awk -v r="$1" -v t="$2" -v id="$3" '$1 == r && $2 == t { print r, t, id; next } { print }' "$file" > "$file.part"
    else
      { [ -f "$file" ] && cat "$file"; printf '%s %s %s\n' "$1" "$2" "$3"; } > "$file.part"
    fi
    mv -f "$file.part" "$file"
  ) 8>> "$R9700_STUB_DIR/calls.lock"
}

# image_id <repository> <tag>: prints the id of the record (nothing and 1 when there is none)
image_id() {
  awk -v r="$1" -v t="$2" '$1 == r && $2 == t { print $3; f = 1; exit } END { exit !f }' "$R9700_STUB_DIR/images" 2> /dev/null
}

# tag_image <source> <target>: the target takes the id of the source
tag_image() {
  local id rc
  rc="$(moe_answer tag_rc 0)"
  if [ "$rc" != 0 ]; then echo "stub: tag failed (scripted)" >&2; return "$rc"; fi
  if [ "$#" -ne 2 ]; then echo "stub: tag: two references only" >&2; return 2; fi
  if ! id="$(image_id "${1%:*}" "${1##*:}")"; then echo "stub: tag: no such image: $1" >&2; return 1; fi
  image_set "${2%:*}" "${2##*:}" "$id"
  # answers/tag_after_rc: the engine moved the tag and the call still returns this code (a ceiling that hits after the move: 124)
  rc="$(moe_answer tag_after_rc 0)"
  if [ "$rc" != 0 ]; then echo "stub: tag cut after the move (scripted)" >&2; return "$rc"; fi
}

# remove_image <reference>: removes exactly that record (the engine's `rmi` of a tag)
remove_image() {
  local file="$R9700_STUB_DIR/images" rc
  if [ "$#" -ne 1 ] || [[ ${1:-} == -* ]]; then echo "stub: rmi: one exact reference only" >&2; return 2; fi
  rc="$(moe_answer rmi_rc 0)"
  if [ "$rc" != 0 ]; then echo "stub: rmi failed (scripted)" >&2; return "$rc"; fi
  if ! image_id "${1%:*}" "${1##*:}" > /dev/null; then echo "stub: rmi: no such image: $1" >&2; return 1; fi
  (
    flock 8
    awk -v r="${1%:*}" -v t="${1##*:}" '!($1 == r && $2 == t)' "$file" > "$file.part"
    mv -f "$file.part" "$file"
  ) 8>> "$R9700_STUB_DIR/calls.lock"
  printf 'Untagged: %s%s\n' "$1" "$CRLF"
}

# image_call list [--no-trunc]: the observed table of `wslc image list` (2026-11-07): the id is the whole `sha256:<64 hex>` with --no-trunc, else its first 12 hex characters
image_call() {
  local skip=0 count=0 trunc=yes repository tag id
  [ "${1:-}" = list ] || { echo "stub: wslc: unknown image subcommand" >&2; return 2; }
  shift
  [ "${1:-}" = --no-trunc ] || trunc=no
  if [ -f "$R9700_STUB_DIR/fail-image-list" ]; then
    read -r skip count < "$R9700_STUB_DIR/fail-image-list"
    if [ -z "$count" ]; then count="$skip"; skip=0; fi
    if [ "${skip:-0}" -gt 0 ]; then
      printf '%s %s\n' "$((skip - 1))" "$count" > "$R9700_STUB_DIR/fail-image-list"
    elif [ "${count:-0}" -gt 0 ]; then
      printf '0 %s\n' "$((count - 1))" > "$R9700_STUB_DIR/fail-image-list"
      echo "stub: image list failed (scripted)" >&2
      return 1
    fi
  fi
  if [ -f "$R9700_STUB_DIR/answers/image_list" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/image_list"; return 0; fi
  printf 'REPOSITORY      TAG      IMAGE ID      CREATED       SIZE%s\n' "$CRLF"
  [ -f "$R9700_STUB_DIR/images" ] || return 0
  while read -r repository tag id; do
    [ "$trunc" = yes ] || id="${id#sha256:}" id="${id:0:12}"
    printf '%s   %s   %s   6 hours ago   27.3GB%s\n' "$repository" "$tag" "$id" "$CRLF"
  done < "$R9700_STUB_DIR/images"
}

# volume list | volume create <name> (E1.S1): the volumes are files below $R9700_STUB_DIR/volumes/ (one empty file per volume).
#   fail-volume-list        a count: the next that many `volume list` calls fail (code 1, one `stub:` line), then it works again
#   answers/volume_create_rc   a non-zero code: `volume create` fails with it (one `stub:` line) and makes nothing
# The list prints the header `DRIVER    VOLUME NAME` and a `guest     <name>` line per volume, sorted; creating a volume that exists exits 1 with the two
# lines the real wslc printed on 2026-11-07 (`Cannot create a file when that file already exists.`, `Error code: ERROR_ALREADY_EXISTS`).
volume_call() {
  local _left name rc file dir="$R9700_STUB_DIR/volumes"
  case "${1:-}" in
    list)
      if [ -f "$R9700_STUB_DIR/fail-volume-list" ]; then
        read -r _left < "$R9700_STUB_DIR/fail-volume-list"
        if [ "${_left:-0}" -gt 0 ]; then
          printf '%s\n' "$((_left - 1))" > "$R9700_STUB_DIR/fail-volume-list"
          echo "stub: volume list failed (scripted)" >&2
          return 1
        fi
      fi
      printf 'DRIVER    VOLUME NAME%s\n' "$CRLF"
      if [ -d "$dir" ]; then
        for file in "$dir"/*; do
          [ -e "$file" ] || continue
          printf 'guest     %s%s\n' "${file##*/}" "$CRLF"
        done
      fi
      ;;
    create)
      name="${2:-}"
      if [ -z "$name" ]; then echo "stub: wslc: volume create needs a name" >&2; return 2; fi
      if [[ $name == */* ]]; then echo "stub: wslc: volume create: \"$name\" holds a slash" >&2; return 2; fi
      rc="$(moe_answer volume_create_rc 0)"
      if [ "$rc" != 0 ]; then echo "stub: volume create failed (scripted)" >&2; return "$rc"; fi
      if [ -e "$dir/$name" ]; then
        printf 'Cannot create a file when that file already exists.%s\nError code: ERROR_ALREADY_EXISTS%s\n' "$CRLF" "$CRLF"
        return 1
      fi
      stub_mkdir "$dir"
      : > "$dir/$name"
      printf '%s%s\n' "$name" "$CRLF"
      ;;
    *) echo "stub: wslc: unknown volume subcommand \"${1:-}\"" >&2; return 2 ;;
  esac
}

# remove <name> (E1.S2): removes a STOPPED container (a file stopped/<name>, planted by the test); a running one and an unknown one are refused with a line.
#   answers/remove_rc   a non-zero code: `remove` fails with it (one `stub:` line) and removes nothing
remove_container() {
  local name="${1:-}" rc
  rc="$(moe_answer remove_rc 0)"
  if [ "$rc" != 0 ]; then echo "stub: remove failed (scripted)" >&2; return "$rc"; fi
  if stub_alive "$R9700_STUB_DIR/containers/$name.pid"; then echo "stub: cannot remove a running container: $name" >&2; return 1; fi
  if [ ! -f "$R9700_STUB_DIR/stopped/$name" ]; then echo "stub: no such container: $name" >&2; return 1; fi
  rm -f "$R9700_STUB_DIR/stopped/$name"
  printf '%s%s\n' "$name" "$CRLF"
}

# inspect <reference> (E1.S2): the JSON of an image or container. answers/inspect is printed as it is (CRLF ends added), else one default record with a Created time;
# answers/inspect_rc is the exit code (non-zero: one `stub: inspect:` line and nothing else).
inspect_reference() {
  local rc
  rc="$(moe_answer inspect_rc 0)"
  if [ "$rc" != 0 ]; then echo "stub: inspect: no such reference (scripted): ${1:-}" >&2; return "$rc"; fi
  if [ -f "$R9700_STUB_DIR/answers/inspect" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/inspect"
  else printf '[{"Id": "sha256:stub", "Created": "2026-11-07T10:00:00.000000000Z"}]%s\n' "$CRLF"; fi
}

case "${1:-}" in
  run) shift; run_container "$@" ;;
  remove) shift; remove_container "$@" ;;
  inspect) shift; inspect_reference "$@" ;;
  list) list_containers ;;
  build) shift; build_image "$@" ;;
  tag) shift; tag_image "$@" ;;
  rmi) shift; remove_image "$@" ;;
  image) shift; image_call "$@" ;;
  volume) shift; volume_call "$@" ;;
  stop)
    [ -f "$R9700_STUB_DIR/stop-delay-${2:-}" ] && sleep "$(cat "$R9700_STUB_DIR/stop-delay-${2:-}")"
    # stop-fail-<name>: a count; that many `stop <name>` calls fail and leave the container running (a stop that does not work), then stops work again
    if [ -f "$R9700_STUB_DIR/stop-fail-${2:-}" ]; then
      read -r _left < "$R9700_STUB_DIR/stop-fail-${2:-}"
      if [ "${_left:-0}" -gt 0 ]; then
        printf '%s\n' "$((_left - 1))" > "$R9700_STUB_DIR/stop-fail-${2:-}"
        echo "stub: stop failed (scripted): ${2:-}" >&2
        exit 1
      fi
    fi
    # stop-gone-<name>: a count; that many `stop <name>` calls fail with code 1 AND the container is gone (the stop worked, the call said it did not: the
    # observed case of 2026-11-03, two of six stops of the operator's server). The stop prints its error as a failing stop does, then the container is
    # stopped as usual, so the next `list` has no such container.
    if [ -f "$R9700_STUB_DIR/stop-gone-${2:-}" ]; then
      read -r _left < "$R9700_STUB_DIR/stop-gone-${2:-}"
      if [ "${_left:-0}" -gt 0 ]; then
        printf '%s\n' "$((_left - 1))" > "$R9700_STUB_DIR/stop-gone-${2:-}"
        stub_container_stop "${2:-}" > /dev/null 2>&1
        echo "stub: stop returned an error but the container is gone (scripted): ${2:-}" >&2
        exit 1
      fi
    fi
    # stop-lines-<name>: a number; `stop <name>` prints that many lines first (a verbose wslc: the adapter keeps only the last twenty)
    if [ -f "$R9700_STUB_DIR/stop-lines-${2:-}" ]; then
      for _n in $(seq 1 "$(cat "$R9700_STUB_DIR/stop-lines-${2:-}")"); do printf 'stub stop noise %s%s\n' "$_n" "$CRLF"; done
    fi
    # on-stop-<name>: a script of the test (E1.S3), run once that container is stopped: the way a test changes the world at a unit's end
    if stub_container_stop "${2:-}"; then
      printf '%s%s\n' "$2" "$CRLF"
      if [ -f "$R9700_STUB_DIR/on-stop-${2:-}" ]; then bash "$R9700_STUB_DIR/on-stop-${2:-}"; fi
    else
      exit 1
    fi
    ;;
  logs) stub_require_running "${2:-}" || exit 1; [ -f "$R9700_STUB_DIR/on-logs-${2:-}" ] && bash "$R9700_STUB_DIR/on-logs-${2:-}"; [ -f "$R9700_STUB_DIR/answers/logs" ] && cat "$R9700_STUB_DIR/answers/logs"
    [ -f "$R9700_STUB_DIR/logs.d/${2:-}" ] && cat "$R9700_STUB_DIR/logs.d/${2:-}" # E2.S2: what the bench runs of this container added to its log
    exit 0 ;;
  exec) stub_require_running "${2:-}" || exit 1; shift; exec_in "$@" ;;
  *) echo "stub: wslc: unknown subcommand \"${1:-}\"" >&2; exit 2 ;;
esac
