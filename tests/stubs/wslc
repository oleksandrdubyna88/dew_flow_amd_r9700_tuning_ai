#!/usr/bin/env bash
# The CI stand-in for wslc.exe (E1.S2 decision 12). Answers are scripted by the test through files below $R9700_STUB_DIR; see
# stub_common.sh. Output has CRLF line ends, like a Windows executable.
set -u
# shellcheck source=tests/stubs/stub_common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/stub_common.sh"
stub_log wslc "$@"
stub_mode_if_asked

CRLF=$'\r'

# ---- the MoE foreground runs (E2.S2 decision 9) -----------------------------------------------------------------------------------------------
# moe_kind <argv...>: sets MOE_KIND to `bench` (a benchmark_moe.py run: `--tune` is a chunk, else a kernel A/B container), `clear` (the cache-clear
# program: `sh -c` with a program that names triton-moe-tune) or "" and returns 1 when the run is none of them (the fingerprint's throwaway run).
moe_kind() {
  local arg prev=""
  MOE_KIND=""
  for arg in "$@"; do
    [ "$arg" = benchmark_moe.py ] && MOE_KIND=bench
    [ "$prev" = -c ] && [[ $arg == *triton-moe-tune* ]] && MOE_KIND=clear
    prev="$arg"
  done
  [ -n "$MOE_KIND" ]
}

# moe_foreground <name> <argv...>: the container of a foreground `run --rm --name <name>`. Like a detached one it is a recorded process
# (containers/<name>.pid, here the stub's own pid) for its duration, so `wslc list` shows it and `wslc stop <name>` ends it (UNVERIFIED for the real
# wslc: nobody has observed whether a foreground run is listed). The record goes at the stub's end, however it ends. Every answer file is read from
# $R9700_STUB_DIR only:
#   answers/moe_tune_seconds, moe_tune_rc, moe_tune_log   a chunk (`--tune`): sleeps, writes every file of the folder answers/moe_json/ into the
#       save dir (the path /work/ read as $R9700_WORK_DIR/; no folder: nothing is written, the half-written chunk), prints the log, exits with the rc
#   answers/moe_ab_seconds, moe_ab.<arm>[.<rep>]          a kernel A/B container (the arm is the word after `moe-ab-` in the name, the rep its number): sleeps, prints
#   answers/moe_cache                                     the clear: prints it (default one `du` line)
moe_foreground() {
  local name="$1" file="$R9700_STUB_DIR/containers/$1.pid"
  shift
  if stub_alive "$file"; then echo "stub: container name in use: $name" >&2; exit 1; fi
  stub_record_pid "$file" "$$"
  MOE_PIDFILE="$file"
  trap 'rm -f "$MOE_PIDFILE"; [ -z "${MOE_SLEEPER:-}" ] || kill "$MOE_SLEEPER" 2> /dev/null' EXIT
  trap 'exit 143' TERM
  # on-start-<name>: a script of the test, run once that container has started (E2.S2: the way a test arms a fault for the calls that come AFTER a
  # unit's container started, like the cleanup hook's clear, however that container ends: stopped by name, killed with its session, or cut by its ceiling)
  [ -f "$R9700_STUB_DIR/on-start-$name" ] && bash "$R9700_STUB_DIR/on-start-$name"
  if [ "$MOE_KIND" = clear ] && [ -f "$R9700_STUB_DIR/moe_clear_mode" ]; then stub_mode_apply "$(cat "$R9700_STUB_DIR/moe_clear_mode")"; fi
  if [ "$MOE_KIND" = clear ]; then
    if [ -f "$R9700_STUB_DIR/answers/moe_cache" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/moe_cache"; else printf '1.3G\t/root/.cache/vllm/triton-moe-tune%s\n' "$CRLF"; fi
    return 0
  fi
  moe_bench "$name" "$@"
}

# moe_answer <file name> <default>: the content of answers/<file name> (first line), else the default
moe_answer() {
  if [ -f "$R9700_STUB_DIR/answers/$1" ]; then head -n 1 "$R9700_STUB_DIR/answers/$1"; else printf '%s\n' "$2"; fi
}

# moe_bench <name> <argv...>: a chunk or a kernel A/B container (see the answers above)
moe_bench() {
  local name="$1" arg prev="" tune=no save="" arm rep keys=() collecting=no seconds rc
  shift
  for arg in "$@"; do
    [ "$arg" = --tune ] && tune=yes
    [ "$prev" = --save-dir ] && save="$arg"
    if [[ $arg == --* ]]; then collecting=no; fi
    [ "$collecting" = yes ] && keys+=("$arg")
    [ "$arg" = --batch-size ] && collecting=yes
    prev="$arg"
  done
  if [ "$tune" = yes ]; then seconds="$(moe_answer moe_tune_seconds 0)"; else seconds="$(moe_answer moe_ab_seconds 0)"; fi
  sleep "$seconds" < /dev/null > /dev/null 2>&1 &
  MOE_SLEEPER=$!
  wait "$MOE_SLEEPER"
  if [ "$tune" = yes ]; then
    if [ -d "$R9700_STUB_DIR/answers/moe_json" ]; then cp "$R9700_STUB_DIR"/answers/moe_json/* "${R9700_WORK_DIR:?}/${save#/work/}/"; fi
    if [ -f "$R9700_STUB_DIR/answers/moe_tune_log" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/moe_tune_log"
    else
      printf 'Start tuning over 3 configurations%s\nTuning space has 3 configs%s\n' "$CRLF" "$CRLF"
      printf 'Completed tuning for batch_size=%s%s\n' "${keys[0]:-0}" "$CRLF"
    fi
    rc="$(moe_answer moe_tune_rc 0)"
    return "$rc"
  fi
  arm="${name##*moe-ab-}"
  rep="${arm##*-}"
  arm="${arm%-*}"
  # answers/moe_ab.<arm>.<rep> (one log per rep, so a table of three different medians can be served), else answers/moe_ab.<arm>
  if [ -f "$R9700_STUB_DIR/answers/moe_ab.$arm.$rep" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/moe_ab.$arm.$rep"
  elif [ -f "$R9700_STUB_DIR/answers/moe_ab.$arm" ]; then sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/moe_ab.$arm"; fi
  return 0
}

# run -d --rm --name X ...: a detached container; prints three lines. `run --rm ...` WITHOUT -d is a foreground run (E1.S3: the throwaway
# container of the fingerprint): it starts nothing and prints answers/find, a `---` line and answers/genconfig (a missing file prints nothing).
run_container() {
  local name="" prev="" detached=no
  for arg in "$@"; do
    [ "$prev" = --name ] && name="$arg"
    [ "$arg" = -d ] && detached=yes
    prev="$arg"
  done
  if [ "$detached" = no ] && moe_kind "$@"; then
    moe_foreground "$name" "$@"
    return $?
  fi
  if [ "$detached" = no ]; then
    [ -f "$R9700_STUB_DIR/hang-foreground-run" ] && stub_hang # a throwaway container that never answers (the caller's ceiling ends it)
    [ -f "$R9700_STUB_DIR/answers/find" ] && sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/find"
    printf -- '---%s\n' "$CRLF"
    [ -f "$R9700_STUB_DIR/answers/genconfig" ] && sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/genconfig"
    return 0
  fi
  if [ -z "$name" ]; then
    echo "stub: run without --name" >&2
    exit 2
  fi
  if stub_alive "$R9700_STUB_DIR/containers/$name.pid"; then
    echo "stub: container name in use: $name" >&2 # the live record is never overwritten
    exit 1
  fi
  stub_container_start "$name"
  printf 'stub-line-1%s\nstub-line-2%s\nstub-line-3 %s%s\n' "$CRLF" "$CRLF" "$name" "$CRLF"
}

# <stub dir>/fail-list: "<count>" or "<skip> <count>": after <skip> good `list` calls (default 0) the next <count> calls fail (a transient fault of wslc)
list_containers() {
  local file skip=0 count=0
  if [ -f "$R9700_STUB_DIR/fail-list" ]; then
    read -r skip count < "$R9700_STUB_DIR/fail-list"
    if [ -z "$count" ]; then count="$skip"; skip=0; fi
    if [ "${skip:-0}" -gt 0 ]; then
      printf '%s %s\n' "$((skip - 1))" "$count" > "$R9700_STUB_DIR/fail-list"
    elif [ "${count:-0}" -gt 0 ]; then
      printf '0 %s\n' "$((count - 1))" > "$R9700_STUB_DIR/fail-list"
      echo "stub: wslc list failed (scripted)" >&2
      exit 1
    fi
  fi
  printf 'CONTAINER ID  NAME%s\n' "$CRLF"
  for file in "$R9700_STUB_DIR"/containers/*.pid; do
    [ -e "$file" ] || continue
    stub_alive "$file" || continue
    printf '0123abcd4567  %s%s\n' "$(basename "$file" .pid)" "$CRLF"
  done
}

# exec <name> <cmd...>: vllm bench serve prints its metric lines of the answers/bench file; a python urlopen program answers from
# answers/ready (answers/ready.<name> first, E1.S3: one container can be made to fail) or, for /metrics, from answers/metrics; the harness
# of the quality step writes its result file; anything else succeeds silently.
#   answers/bench, legacy form: lines WITHOUT a group, three per block; the block of the call is (c == 1 ? 0 : 3) + seed - 1, and a block that
#       is not there repeats the last one. A prefill call (--random-output-len 128) takes block 6 + 3 * <position of its length in
#       R9700_PREFILL_LENS> + seed - 1.
#   answers/bench, tagged form (the first line starts `c=<n> r=<n> ` or `prefill<n> r=<n> `): the lines of the asked group and seed with the
#       group cut off; a line that is not there stays missing (a measurement the server did not print). Decode: group c=<c>; prefill: group
#       prefill<--random-input-len>.
#   R9700_STUB_DELAY_S: every `bench serve` call sleeps that long first (a measurement that takes time).
bench_lines() {
  local c="$1" seed="$2" len="$3" outlen="$4" file="$R9700_STUB_DIR/answers/bench" first group idx pos=0 n word
  [ -f "$file" ] || return 0
  first="$(head -n 1 "$file")"
  if [ "$outlen" = 128 ]; then group="prefill$len"; else group="c=$c"; fi
  if [[ $first =~ ^(c=[0-9]+|prefill[0-9]+)\ r=[0-9]+\  ]]; then
    awk -v g="$group r=$seed " -v crlf="$CRLF" 'index($0, g) == 1 { printf "%s%s\n", substr($0, length(g) + 1), crlf }' "$file"
    return 0
  fi
  if [ "$outlen" = 128 ]; then
    for word in ${R9700_PREFILL_LENS:-}; do [ "$word" = "$len" ] && break; pos=$((pos + 1)); done
    idx=$((6 + 3 * pos + seed - 1))
  else
    idx=$(((c == 1 ? 0 : 3) + seed - 1))
  fi
  awk -v idx="$idx" -v crlf="$CRLF" '{ line[NR] = $0 } END { b = idx; if (3 * b + 3 > NR) b = int((NR - 1) / 3); for (i = 3 * b + 1; i <= 3 * b + 3 && i <= NR; i++) printf "%s%s\n", line[i], crlf }' "$file"
}

# harness_call <script> <sub command> <argv...>: what the container's lib/harness.py would do, minus the server: the file of --out (a path under
# /work, which is $R9700_WORK_DIR here) is written with the shape the record check reads (collect: answers/prompts_n results, default 20; gsm8k:
# n 200 with the stderr the verdict recomputes). The real one does not make the folder either.
harness_call() {
  local sub="$2" out="" prev="" arg real
  shift 2
  for arg in "$@"; do
    [ "$prev" = --out ] && out="$arg"
    prev="$arg"
  done
  [ -n "$out" ] || { echo "stub: harness call without --out" >&2; return 2; }
  real="${R9700_WORK_DIR:?R9700_WORK_DIR is not set}/${out#/work/}"
  [ -d "$(dirname "$real")" ] || { echo "FileNotFoundError: $(dirname "$out")" >&2; return 1; }
  case $sub in
    collect) python3 -c 'import json, sys; json.dump({"results": [{"prompt": str(i)} for i in range(int(sys.argv[2]))]}, open(sys.argv[1] + ".part", "w"))' "$real" "$(cat "$R9700_STUB_DIR/answers/prompts_n" 2> /dev/null || echo 20)" ;;
    gsm8k) python3 -c 'import json, math, sys; p = 0.85; json.dump({"summary": {"n": 200, "correct": 170, "accuracy": p, "stderr": math.sqrt(p * (1 - p) / 200)}, "items": []}, open(sys.argv[1] + ".part", "w"))' "$real" ;;
    *) echo "stub: harness: unknown sub command $sub" >&2; return 2 ;;
  esac
  mv "$real.part" "$real"
  echo "wrote $out"
}

exec_in() {
  local name="$1" arg prev="" c="" seed="" len="" outlen="" word
  shift
  if [ "${1:-}" = vllm ] && [ "${2:-}" = bench ] && [ "${3:-}" = serve ]; then
    for arg in "$@"; do
      [ "$prev" = --max-concurrency ] && c="$arg"
      [ "$prev" = --seed ] && seed="$arg"
      [ "$prev" = --random-input-len ] && len="$arg"
      [ "$prev" = --random-output-len ] && outlen="$arg"
      prev="$arg"
    done
    [ -n "${R9700_STUB_DELAY_S:-}" ] && sleep "$R9700_STUB_DELAY_S"
    bench_lines "$c" "$seed" "$len" "$outlen"
  elif [ "${1:-}" = python3 ] && [[ ${2:-} == */harness.py ]]; then
    harness_call "$2" "${3:-}" "${@:4}"
  elif [ "${1:-}" = python3 ] && [ "${2:-}" = -c ] && [[ ${3:-} == *urlopen*/metrics* ]]; then
    [ -f "$R9700_STUB_DIR/answers/metrics" ] && sed "s/\$/$CRLF/" "$R9700_STUB_DIR/answers/metrics"
    return 0
  elif [ "${1:-}" = python3 ] && [ "${2:-}" = -c ] && [[ ${3:-} == *urlopen* ]]; then
    if [ -f "$R9700_STUB_DIR/answers/ready.$name" ]; then word="$(stub_answer "ready.$name")"; else word="$(stub_answer ready)"; fi
    [ "$word" = hang ] && stub_hang # a probe that never answers (the caller's ceiling ends it)
    if [[ $3 == */v1/completions* ]]; then
      case $word in
        ok) printf 'models%s\ncompletion%s\n' "$CRLF" "$CRLF" ;;
        models-only) printf 'models%s\ncompletion: HTTP 500%s\n' "$CRLF" "$CRLF"; return 1 ;;
        *) printf 'models: <urlopen error>%s\n' "$CRLF"; return 1 ;;
      esac
    else
      case $word in ok | models-only) return 0 ;; *) return 1 ;; esac
    fi
  fi
}

case "${1:-}" in
  run) shift; run_container "$@" ;;
  list) list_containers ;;
  stop)
    [ -f "$R9700_STUB_DIR/stop-delay-${2:-}" ] && sleep "$(cat "$R9700_STUB_DIR/stop-delay-${2:-}")"
    # on-stop-<name>: a script of the test (E1.S3), run once that container is stopped: the way a test changes the world at a unit's end
    if stub_container_stop "${2:-}"; then
      printf '%s%s\n' "$2" "$CRLF"
      if [ -f "$R9700_STUB_DIR/on-stop-${2:-}" ]; then bash "$R9700_STUB_DIR/on-stop-${2:-}"; fi
    else
      exit 1
    fi
    ;;
  logs) stub_require_running "${2:-}" || exit 1; [ -f "$R9700_STUB_DIR/answers/logs" ] && cat "$R9700_STUB_DIR/answers/logs"; exit 0 ;;
  exec) stub_require_running "${2:-}" || exit 1; shift; exec_in "$@" ;;
  *) echo "stub: wslc: unknown subcommand \"${1:-}\"" >&2; exit 2 ;;
esac
