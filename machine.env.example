# machine.env — the values that belong to THIS PC. Copy to machine.env (untracked) and edit; never commit machine.env.
# Format: one KEY=VALUE per line; a value is bare, or in one pair of double quotes when it holds spaces. Values are data:
# $ and the backtick are refused, nothing is expanded or executed. An optional key is shown commented out at its default.
# Every key, its type, its legal values and its origin: research/module_config.md

# the command for wslc, a bare name looked up on PATH, or an absolute path
# WSLC=wslc

# Windows PowerShell, for the RAM and disk probes
# POWERSHELL=powershell.exe

# the shell that runs the operator's start script when the server is restored
# RESTORE_SHELL=pwsh.exe

# the container image of the test servers
IMAGE=rocm/vllm:rocm10.1.0_ubuntu24.04_py3.14-pytorch_2.13.0_vllm-0.29.0

# the named volume that holds the model cache
# HF_VOLUME=hf-cache

# the named volume that holds the compile caches
# CACHE_VOLUME=vllm-cache

# the work directory, as a WSL path; it must exist
WORK_DIR=/mnt/c/r9700/work

# the same work directory as a Windows path; it is mounted at /work
WORK_DIR_WIN=C:\r9700\work

# the base directory of every mount source, as a WSL path; it must exist
PATCH_DIR=/mnt/c/r9700/patches

# the same patch directory as a Windows path
PATCH_DIR_WIN=C:\r9700\patches

# the operator's generation-config directory, as a Windows path; mounted at /genconfig
GENCONFIG_WIN=C:\r9700\genconfig

# the GSM8K test file, as a path inside the container
# GSM8K_DATA=/work/gsm8k/test.jsonl

# where series results go, as a WSL path; its parent must exist
RESULTS_DIR=/mnt/c/r9700/results

# the name of the operator's own server container
# PROD_CONTAINER=vllm

# the operator's start script, as a Windows path
RESTORE_SCRIPT_WIN=C:\r9700\start-vllm.ps1

# the arguments of the start script that bring the operator's server back
RESTORE_ARGS="-Model /root/.cache/huggingface/local/Qwen3.6-35B-A3B-GPTQ -ServedName qwen3.6-35b-a3b -MaxModelLen 131072 -MaxNumSeqs 4 -Detach"

# the name prefix of every test container the toolkit starts
# CONTAINER_PREFIX=r9700tune-

# stop the run when the free RAM of the PC falls below this many MB
# RAM_MIN_MB=2048

# the 1-minute load below which the PC counts as quiet
# QUIET_LOAD_MAX=4

# a process command-line pattern that means the PC is busy; empty means no process check
# QUIET_BUSY_PATTERN=

# a command-line substring that excludes a match of the busy pattern
# QUIET_BUSY_IGNORE=

# check the disk event log before each unit: on or off
# DISK_GATE=on

# the clock time (HH:MM, 24 h) by which a run must be over; empty means none
# DEADLINE=

# the ceiling of a run in minutes when DEADLINE is empty or later
# MAX_RUN_MINUTES=720

# how long a server may take to become ready, in seconds
# READY_TIMEOUT_S=1200

# how many failed tries a step gets before the run gives up; at most MAX_SERVER_STOPS
# MAX_FAILED_TRIES=3

# how many times one invocation may stop the operator's server
# MAX_SERVER_STOPS=3

# seconds kept free before the deadline for cleanup and restore; at least READY_TIMEOUT_S + 300
# CLEANUP_BUDGET_S=1500
