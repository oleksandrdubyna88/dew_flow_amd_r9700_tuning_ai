#!/usr/bin/env bash
# bin/r9700 — the one entry point of the R9700 tuning toolkit: `r9700 <verb> [arguments]`. The verbs: commands, init, step (E1.S2), series and
# verdict (E1.S3: the arm-round records of a series and the ship test read back from them), moe-tune (E2.S3: chunk, merge, activate, ab).
#
# Order of every invocation that can change the machine (decision 4): parse the arguments -> take the lock -> restore from the recovery
# marker when one exists -> load and validate the config -> work. A verb that only reads (verdict) takes the lock only when a marker
# exists, to restore first, and releases it before it reads.
#
# Exit codes (the table with the stderr line of each is in research/architecture.md; README.md lists them too):
#   0 ok
#   1 verdict: at least one arm is INCOMPLETE (verdict.py's own code)
#   2 config or arguments refused; a series refused to go on (the identity changed, no fingerprint over records); verdict input error;
#     moe-tune: a refused argument, a model with MOE_DTYPE=none, a merge input error, an activation refused (not a record, or a server is listed)
#   4 another run holds the lock
#   5 the restore did not become ready
#   6 the deadline stopped the step, or the worker said nothing more fits
#   7 the step failed MAX_FAILED_TRIES times
#   8 not quiet before the deadline, or admitted MAX_SERVER_STOPS times (each admission stops the operator's server)
#   9 the disk gate stopped the run
#   10 init found a problem
#   11 the recovery marker cannot be read
#   129 interrupted by HUP, cleanup done
#   130 interrupted by INT, cleanup done
#   143 interrupted by TERM, cleanup done
set -u
R9700_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/config.sh
source "$R9700_ROOT/lib/config.sh" || exit 2
for _lib in run_guarded adapter restore guard_quiet disk_gate guard_common guard_ram guard_deadline serve wait_ready bench step series moe moe_verb; do
  # shellcheck source=/dev/null
  source "$R9700_ROOT/lib/$_lib.sh" || exit 2
done

# model_resolve [<file, or name of models/<name>.env>]: prints the model file; 2 with one line when it is none
model_resolve() {
  local arg="${1:-}"
  local -a files=()
  if [ -n "$arg" ]; then
    if [[ $arg == */* || $arg == *.env ]]; then
      [ -f "$arg" ] && { printf '%s\n' "$arg"; return 0; }
      echo "r9700: model file \"$arg\" not found" >&2
      return 2
    fi
    [ -f "$R9700_ROOT/models/$arg.env" ] && { printf '%s\n' "$R9700_ROOT/models/$arg.env"; return 0; }
    echo "r9700: model \"$arg\" not found; legal: $(cd "$R9700_ROOT/models" && ls ./*.env 2> /dev/null | sed -e 's|^\./||' -e 's|\.env$||' | tr '\n' ' ' | sed 's/ $//')" >&2
    return 2
  fi
  files=("$R9700_ROOT"/models/*.env)
  if [ "${#files[@]}" -eq 1 ] && [ -f "${files[0]}" ]; then printf '%s\n' "${files[0]}"; return 0; fi
  echo "r9700: several models in models/ (or none): name one with --model <file or name>" >&2
  return 2
}

# model_arg <verb> <args...>: checks the SYNTAX of the arguments and prints the value of `--model <value>` (the only legal argument), or
# nothing. The model itself is resolved later, after the lock and the restore (a refused model must not leave a marker unrestored).
model_arg() {
  local verb="$1" value=""
  shift
  while [ "$#" -gt 0 ]; do
    case $1 in
      --model)
        if [ "$#" -lt 2 ]; then echo "r9700: $verb: --model needs a value" >&2; return 2; fi
        value="$2"
        shift 2
        ;;
      *) echo "r9700: $verb: unknown argument \"$1\"; legal: --model <file or name>" >&2; return 2 ;;
    esac
  done
  printf '%s\n' "$value"
}

verb_commands() {
  declare -F | awk '{ print $3 }' | grep '^verb_' | sed -e 's/^verb_//' -e 's/_/-/g' | LC_ALL=C sort
}

# init_line <check:> <text>: prints `init: <check>: <text>`. The label carries its own colon: a label that is a bare word of an
# executable ("wslc") would be a command word to tests/check_static.sh --seam, which keeps those words in lib/adapter.sh. init_problem
# prints the same line to stderr too and counts it in INIT_PROBLEMS.
init_line() {
  printf 'init: %s %s\n' "$1" "$2"
}

init_problem() {
  INIT_PROBLEMS=$((INIT_PROBLEMS + 1))
  printf 'init: %s %s\n' "$1" "$2"
  printf 'init: %s %s\n' "$1" "$2" >&2
}

# init_adapter_problem <rc> <message>: the text of a failed adapter call; 124 and 137 say the ceiling ended it
init_adapter_problem() {
  local rc="$1" text="$2" ceiling
  if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then
    ceiling="$(ceil_seconds "$(t_ceiling 60)")"
    printf 'timeout after %s s' "$ceiling"
  else
    printf '%s' "${text%%$'\n'*}"
  fi
}

init_check_dirs() {
  if mkdir -p "$R9700_RESULTS_DIR" 2> /dev/null && [ -w "$R9700_RESULTS_DIR" ]; then init_line "results dir:" ok
  else init_problem "results dir:" "cannot make or write $R9700_RESULTS_DIR"; fi
  if [ -d "$(state_dir)" ] && [ -w "$(state_dir)" ]; then init_line "state dir:" ok
  else init_problem "state dir:" "$(state_dir) is not a writable directory"; fi
}

init_check_telemetry() {
  local out rc
  out="$(win_ram_mb 2>&1)"
  rc=$?
  if [ "$rc" -eq 0 ]; then init_line "ram telemetry:" "ok ($out MB)"
  elif [[ $out == 'adapter: unreadable answer '* ]]; then init_problem "ram telemetry:" "unreadable (${out#adapter: unreadable answer })"
  else init_problem "ram telemetry:" "$(init_adapter_problem "$rc" "$out")"; fi
  if [ "$R9700_DISK_GATE" != on ]; then init_line "disk telemetry:" "skipped (DISK_GATE=off)"; return 0; fi
  out="$(win_disk_newest 2>&1)"
  rc=$?
  if [ "$rc" -eq 0 ]; then init_line "disk telemetry:" "ok (record $out)"
  elif [[ $out == 'adapter: unreadable answer '* ]]; then init_problem "disk telemetry:" "unreadable (${out#adapter: unreadable answer })"
  else init_problem "disk telemetry:" "$(init_adapter_problem "$rc" "$out")"; fi
}

# init_check_containers: wslc answers; the operator's server; every leftover prefixed container is stopped and named
init_check_containers() {
  local listing rc name
  local -a stopped=()
  listing="$(wslc_list 2>&1)"
  rc=$?
  if [ "$rc" -ne 0 ]; then init_problem "wslc:" "$(init_adapter_problem "$rc" "$listing")"; return 0; fi
  init_line "wslc:" ok
  if grep -Fxq -- "$R9700_PROD_CONTAINER" <<< "$listing"; then init_line "$R9700_PROD_CONTAINER:" running; else init_line "$R9700_PROD_CONTAINER:" "not running"; fi
  while read -r name; do
    [[ -n $name && $name == "$R9700_CONTAINER_PREFIX"* ]] || continue
    if wslc_stop "$name"; then stopped+=("$name"); else init_problem "leftover containers:" "$name did not stop"; fi
  done <<< "$listing"
  if [ "${#stopped[@]}" -gt 0 ]; then init_line "leftover containers:" "stopped ${stopped[*]}"; else init_line "leftover containers:" none; fi
}

verb_init() {
  local arg model rc
  INIT_PROBLEMS=0
  arg="$(model_arg init "$@")" || exit 2
  lock_take init || exit $?
  restore_first
  restore_dirs_prune 10
  model="$(model_resolve "$arg")" || exit 2
  config_load "${R9700_MACHINE_ENV:-./machine.env}" "$model" || exit 2
  init_line "config:" ok
  init_check_dirs
  init_check_containers
  init_check_telemetry
  [ "$INIT_PROBLEMS" -eq 0 ]
  rc=$?
  [ "$rc" -eq 0 ] || exit 10
}

# verdict <outdir> [--base <arm>] [--no-quality] [--json <file>]: the ship test over the final records of a series (lib/series.sh). It takes the
# lock only when a marker exists, to restore first, and releases it before it reads; its arguments are checked after that restore.
verb_verdict() {
  if [ -f "$(marker_path)" ]; then
    lock_take verdict || exit $?
    restore_first
    lock_release
  fi
  series_verdict "$@"
  exit $?
}

# prepare_run: what `supervise` calls after the restore-first: resolves the model named in _R9700_MODEL_ARG and loads the config (2 and its
# `config:` lines when refused)
prepare_run() {
  local model
  model="$(model_resolve "$_R9700_MODEL_ARG")" || return 2
  config_load "${R9700_MACHINE_ENV:-./machine.env}" "$model"
}

_STEP_USAGE="r9700: step: usage: step [--show-deadline] [--model <file or name>] <label> -- <command...>"

# verb_step [--show-deadline] [--model <file or name>] <label> -- <command...>: ONE guarded step (lib/step.sh) under `supervise`. The arguments
# are checked before the lock and the restore. --show-deadline prints T_END and T_STOP (epoch seconds) and `START=ok` or `START=refused (<why>)`
# and stops: it reads, it takes no lock, and it exits 0 whenever the config loads.
verb_step() {
  local show=0 label
  _R9700_MODEL_ARG=""
  while [ "$#" -gt 0 ]; do
    case $1 in
      --show-deadline) show=1; shift ;;
      --model)
        if [ "$#" -lt 2 ]; then echo "r9700: step: --model needs a value" >&2; exit 2; fi
        _R9700_MODEL_ARG="$2"
        shift 2
        ;;
      -*) echo "r9700: step: unknown option \"$1\"; legal: --show-deadline, --model" >&2; exit 2 ;;
      *) break ;;
    esac
  done
  label="${1:-}"
  if [ -z "$label" ]; then echo "$_STEP_USAGE" >&2; exit 2; fi
  if ! [[ $label =~ $_STEP_LABEL_RE ]]; then echo "r9700: step: the label \"$label\" is not $_STEP_LABEL_RE" >&2; exit 2; fi
  shift
  if [ "$show" -eq 1 ]; then
    prepare_run || exit 2
    deadline_compute --quiet
    if [ -z "$T_END" ]; then echo "r9700: step: the deadline cannot be computed (see the line above)" >&2; exit 2; fi
    printf 'T_END=%s\nT_STOP=%s\n' "$T_END" "$T_STOP"
    if [ -z "$DEADLINE_WHY" ]; then echo "START=ok"; else echo "START=refused ($DEADLINE_WHY)"; fi
    exit 0
  fi
  if [ "${1:-}" != -- ] || [ "$#" -lt 2 ]; then echo "$_STEP_USAGE" >&2; exit 2; fi
  shift
  supervise step prepare_run step_run "$label" -- "$@"
  exit $?
}

_SERIES_USAGE="r9700: series: usage: series <model file or name> <arm>... [--out <name>] [--rounds <1..20>] [--dry-run]"
_SERIES_OUT_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'

# series_args <args...>: checks the SYNTAX of a `series` command line (before the lock and the restore) and sets _R9700_MODEL_ARG, _SERIES_ARMS,
# _SERIES_OUT, _SERIES_ROUNDS and _SERIES_DRY; 2 with one `r9700: series:` line. Whether an arm is in the arm table is checked later, with the config.
series_args() {
  local base arm
  _R9700_MODEL_ARG="" _SERIES_ARMS=() _SERIES_OUT="" _SERIES_ROUNDS=3 _SERIES_DRY=no
  while [ "$#" -gt 0 ]; do
    case $1 in
      --out)
        [ "$#" -ge 2 ] || { echo "r9700: series: --out needs a value" >&2; return 2; }
        _SERIES_OUT="$2"
        shift 2
        ;;
      --rounds)
        [ "$#" -ge 2 ] || { echo "r9700: series: --rounds needs a value" >&2; return 2; }
        _SERIES_ROUNDS="$2"
        shift 2
        ;;
      --dry-run) _SERIES_DRY=yes; shift ;;
      -*) echo "r9700: series: unknown option \"$1\"; legal: --out <name>, --rounds <1..20>, --dry-run" >&2; return 2 ;;
      *)
        if [ -z "$_R9700_MODEL_ARG" ]; then _R9700_MODEL_ARG="$1"; else _SERIES_ARMS+=("$1"); fi
        shift
        ;;
    esac
  done
  if [ -z "$_R9700_MODEL_ARG" ]; then echo "$_SERIES_USAGE" >&2; return 2; fi
  if [ "${#_SERIES_ARMS[@]}" -eq 0 ]; then echo "r9700: series: at least one arm is needed ($_SERIES_USAGE)" >&2; return 2; fi
  [[ $_SERIES_ROUNDS =~ ^([1-9]|1[0-9]|20)$ ]] || { echo "r9700: series: --rounds \"$_SERIES_ROUNDS\" is not a whole number from 1 to 20" >&2; return 2; }
  for arm in "${_SERIES_ARMS[@]}"; do
    [[ $arm =~ $_RE_ARM ]] || { echo "r9700: series: \"$arm\" is not an arm name (lower-case letters and digits only)" >&2; return 2; }
    [ "$(printf '%s\n' "${_SERIES_ARMS[@]}" | grep -cxF -- "$arm")" -eq 1 ] || { echo "r9700: series: the arm \"$arm\" is given twice" >&2; return 2; }
  done
  if [ -z "$_SERIES_OUT" ]; then
    base="${_R9700_MODEL_ARG##*/}"
    _SERIES_OUT="${base%.env}" # no date (A23): the same command resumes on another day
  fi
  [[ $_SERIES_OUT =~ $_SERIES_OUT_RE ]] || { echo "r9700: series: --out \"$_SERIES_OUT\" is not a name (letters, digits, . _ -; starting with a letter or digit; at most 64)" >&2; return 2; }
}

# series_prepare: what `supervise` calls after the restore-first: the model and the machine config, the arm table, the arms of the command line
# (in the table, mounts present, a container name that fits for the longest label: <arm>-<round>-r2)
series_prepare() {
  local arm
  prepare_run || return 2
  arms_load "$(series_arms_conf)" || return 2
  arms_check "${_SERIES_ARMS[@]}" || return 2
  for arm in "${_SERIES_ARMS[@]}"; do container_name "sp-$arm-$_SERIES_ROUNDS-r2" > /dev/null || return 2; done
}

# series_body: the body of `supervise`: the fingerprint (a refused resume stops here, before anything is stopped), the dry run, the resume count,
# the checks of round 1, then the series as ONE step of the supervisor
series_body() {
  local outdir="$R9700_RESULTS_DIR/$_SERIES_OUT" left recorded
  echo "series: outdir $outdir"
  if [ "$_SERIES_DRY" = yes ]; then
    series_fingerprint "$outdir" "$_SERIES_ROUNDS" dry "${_SERIES_ARMS[@]}" || return 2
    series_dry_run "$outdir" "$_SERIES_ROUNDS" "${_SERIES_ARMS[@]}"
    return $?
  fi
  series_fingerprint "$outdir" "$_SERIES_ROUNDS" real "${_SERIES_ARMS[@]}" || return 2
  series_quality_sync "$outdir"
  left="$(series_left "$outdir" "$_SERIES_ROUNDS" "${_SERIES_ARMS[@]}")"
  if [ "$left" -eq 0 ]; then
    recorded="$(series_recorded "$outdir" "$_SERIES_ROUNDS" "${_SERIES_ARMS[@]}")"
    echo "series: $recorded of $((_SERIES_ROUNDS * ${#_SERIES_ARMS[@]})) arm-rounds recorded, nothing to do"
    return 0
  fi
  series_preflight "$outdir" "$_SERIES_ROUNDS" "${_SERIES_ARMS[@]}" || return 2
  step_run series -- bash "$R9700_ROOT/lib/series.sh" "$outdir" "$_SERIES_ROUNDS" "${_SERIES_ARMS[@]}"
}

# verb_series <model> <arm>... [--out <name>] [--rounds <n>] [--dry-run]: the arms alternate inside each round, every arm-round is recorded only
# when it is complete (lib/series.sh), and the same command again resumes. One supervisor, one step: the operator's server is stopped once and
# restored once.
verb_series() {
  series_args "$@" || exit 2
  supervise series series_prepare series_body
  exit $?
}

# ---------- moe-tune (E2.S3) ----------
_MOE_USAGE="r9700: moe-tune: usage: moe-tune chunk|merge|activate|ab <model> [options]"

# _moe_err <text>: one refusal line of the argument grammar, on stderr
_moe_err() { echo "r9700: moe-tune: $_MOE_MODE: $*" >&2; }

# _moe_opt_legal <mode> <option>: 0 when the mode takes the option; _moe_opt_list <mode> prints its legal options
_moe_opt_list() {
  case $1 in
    chunk) echo "--keys, --coarse, --layer, --chunk, --out, --dry-run" ;;
    ab) echo "--keys, --rule, --rule-keys, --reps, --layer, --out, --dry-run" ;;
    merge) echo "--layer, --base, --out" ;;
    activate) echo "--out, --layer, --force" ;;
  esac
}

_moe_opt_legal() { [[ ", $(_moe_opt_list "$1")," == *", $2,"* ]]; }

# _moe_set_opt <option> <value>: stores the value of an option that takes one (a flag stores `yes`)
_moe_set_opt() {
  case $1 in
    --keys) _MOE_KEYS="$2" ;;
    --layer) _MOE_LAYER="$2" ;;
    --chunk) _MOE_CHUNK="$2" ;;
    --out) _MOE_OUT="$2" ;;
    --rule) _MOE_RULE="$2" ;;
    --rule-keys) _MOE_RULE_KEYS="$2" ;;
    --reps) _MOE_REPS="$2" ;;
    --base) _MOE_BASE="$2" ;;
    --coarse) _MOE_COARSE=yes ;;
    --dry-run) _MOE_DRY=yes ;;
    --force) _MOE_FORCE=yes ;;
  esac
}

# _moe_keys_check <option name> <keys text>: the batch sizes of an option, by the worker's own check (_moe_keys_problem), its line re-prefixed
_moe_keys_check() {
  local text="$2" line
  local -a words=()
  read -r -a words <<< "$text"
  if line="$(_MOE_KEYS_WHAT="$1" _moe_keys_problem "${words[@]}" 2>&1)"; then return 0; fi
  _moe_err "${line#moe: }"
  return 2
}

# _moe_enum <option> <value> <legal words...>: 2 and one line naming the legal values
_moe_enum() {
  local opt="$1" value="$2" word
  shift 2
  for word in "$@"; do [ "$value" = "$word" ] && return 0; done
  _moe_err "$opt \"$value\" is not one of: $*"
  return 2
}

# _moe_args_gpu: the checks of the two GPU modes (chunk, ab)
_moe_args_gpu() {
  local default
  _moe_enum --layer "$_MOE_LAYER" experts draft || return 2
  [ -n "$_MOE_KEYS" ] || { _moe_err "--keys is required"; return 2; }
  _moe_keys_check --keys "$_MOE_KEYS" || return 2
  if [ "$_MOE_MODE" = chunk ]; then
    default="$_MOE_LAYER-$([ "$_MOE_COARSE" = yes ] && echo coarse || echo full)-$(tr -s ' ' '-' <<< "$_MOE_KEYS" | sed -e 's/^-//' -e 's/-$//')"
    [ -n "$_MOE_CHUNK" ] || _MOE_CHUNK="$default"
    [[ $_MOE_CHUNK =~ $_MOE_CHUNK_RE ]] || {
      _moe_err "the chunk name \"$_MOE_CHUNK\" is not $_MOE_CHUNK_RE (the name is made from the layer, the search and the keys: pass --chunk <name>)"
      return 2
    }
    return 0
  fi
  [ -n "$_MOE_RULE" ] || { _moe_err "--rule is required"; return 2; }
  _moe_enum --rule "$_MOE_RULE" each median || return 2
  [ -n "$_MOE_RULE_KEYS" ] || { _moe_err "--rule-keys is required"; return 2; }
  _moe_keys_check --rule-keys "$_MOE_RULE_KEYS" || return 2
  local key
  for key in $_MOE_RULE_KEYS; do
    [[ " $_MOE_KEYS " == *" $key "* ]] || { _moe_err "rule key $key is not in --keys"; return 2; }
  done
  [[ $_MOE_REPS =~ ^[1-9]$ ]] || { _moe_err "--reps \"$_MOE_REPS\" is not a whole number from 1 to 9"; return 2; }
}

# _moe_args_other <positionals after the model...>: the checks of merge and activate
_moe_args_other() {
  local word
  if [ "$_MOE_MODE" = merge ]; then
    [ -z "$_MOE_LAYER" ] || _moe_enum --layer "$_MOE_LAYER" experts draft || return 2
    [ "$#" -ge 1 ] || { _moe_err "at least one chunk name is needed"; return 2; }
    for word in "$@"; do
      [[ $word =~ $_MOE_CHUNK_RE ]] || { _moe_err "the chunk name \"$word\" is not $_MOE_CHUNK_RE"; return 2; }
    done
    _MOE_CHUNKS=("$@")
    return 0
  fi
  [ -z "$_MOE_LAYER" ] || _moe_enum --layer "$_MOE_LAYER" experts draft || return 2
  [ "$#" -ge 1 ] || { _moe_err "a stamp is needed (the one that merge printed)"; return 2; }
  [ "$#" -eq 1 ] || { _moe_err "unexpected argument \"$2\""; return 2; }
  [[ $1 =~ $_MOE_NAME_RE ]] || { _moe_err "\"$1\" is not a stamp ($_MOE_NAME_RE)"; return 2; }
  _MOE_STAMP="$1"
}

# moe_tune_args <mode> <args...>: checks the SYNTAX of a `moe-tune` command line (before the lock and the restore) and sets _MOE_MODE, _R9700_MODEL_ARG,
# _MOE_MODEL (its name), _MOE_KEYS, _MOE_COARSE, _MOE_LAYER, _MOE_CHUNK, _MOE_OUT, _MOE_RULE, _MOE_RULE_KEYS, _MOE_REPS, _MOE_BASE, _MOE_CHUNKS,
# _MOE_STAMP, _MOE_FORCE and _MOE_DRY; 2 with one `r9700: moe-tune: <mode>:` line. What needs the config (the model, MOE_DTYPE) is checked later.
moe_tune_args() {
  local mode="${1:-}"
  local -a pos=()
  case $mode in
    chunk | merge | activate | ab) ;;
    "") echo "$_MOE_USAGE" >&2; return 2 ;;
    *) echo "r9700: moe-tune: unknown mode \"$mode\"; legal: chunk merge activate ab ($_MOE_USAGE)" >&2; return 2 ;;
  esac
  shift
  _MOE_MODE="$mode" _R9700_MODEL_ARG="" _MOE_KEYS="" _MOE_COARSE=no _MOE_LAYER=experts _MOE_CHUNK="" _MOE_OUT="" _MOE_RULE="" _MOE_RULE_KEYS=""
  _MOE_REPS=3 _MOE_BASE=auto _MOE_CHUNKS=() _MOE_STAMP="" _MOE_FORCE=no _MOE_DRY=no
  case $mode in merge | activate) _MOE_LAYER="" ;; esac # no default layer: the record says it (merge.env), or --layer
  while [ "$#" -gt 0 ]; do
    case $1 in
      -*)
        _moe_opt_legal "$mode" "$1" || { _moe_err "unknown option \"$1\"; legal: $(_moe_opt_list "$mode")"; return 2; }
        case $1 in
          --coarse | --dry-run | --force) _moe_set_opt "$1" yes; shift ;;
          *) [ "$#" -ge 2 ] || { _moe_err "$1 needs a value"; return 2; }; _moe_set_opt "$1" "$2"; shift 2 ;;
        esac
        ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  if [ "${#pos[@]}" -eq 0 ]; then echo "$_MOE_USAGE" >&2; return 2; fi
  _R9700_MODEL_ARG="${pos[0]}"
  _MOE_MODEL="${_R9700_MODEL_ARG##*/}"
  _MOE_MODEL="${_MOE_MODEL%.env}"
  [[ $_MOE_MODEL =~ $_MOE_MODEL_RE ]] || { _moe_err "the model name \"$_MOE_MODEL\" is not $_MOE_MODEL_RE"; return 2; }
  [ -n "$_MOE_OUT" ] || _MOE_OUT="moe-$_MOE_MODEL" # no date: the same command resumes on another day
  [[ $_MOE_OUT =~ $_MOE_NAME_RE ]] || { _moe_err "--out \"$_MOE_OUT\" is not a name ($_MOE_NAME_RE)"; return 2; }
  case $mode in
    chunk | ab) [ "${#pos[@]}" -eq 1 ] || { _moe_err "unexpected argument \"${pos[1]}\""; return 2; }; _moe_args_gpu ;;
    *) _moe_args_other "${pos[@]:1}" ;;
  esac
}

# moe_prepare: what `supervise` calls after the restore-first: the model and the machine config, the refusal of a model with no MoE layers (the experts
# layer of a model with MOE_DTYPE=none; `activate` reads no model dtype), and the container labels of the longest names
moe_prepare() {
  prepare_run || return 2
  if [ "$_MOE_MODE" != activate ] && [ "$_MOE_LAYER" = experts ] && [ "$R9700_MOE_DTYPE" = none ]; then
    echo "r9700: moe-tune: $_MOE_MODEL: MOE_DTYPE=none: no MoE layers to tune" >&2
    return 2
  fi
  if [ "$_MOE_MODE" = chunk ]; then container_name "moe-tune-$_MOE_CHUNK" > /dev/null || return 2; fi
  if [ "$_MOE_MODE" = ab ]; then container_name "moe-ab-default-$_MOE_REPS" > /dev/null || return 2; fi
  return 0
}

# moe_chunk_body: the body of `supervise` for `chunk`: the files are placed (hash-checked, before anything is stopped), the dry run, the count of a
# recorded chunk (before admission: nothing is stopped for a chunk that is done), then the chunk as ONE step of the supervisor
moe_chunk_body() {
  local outdir="$R9700_RESULTS_DIR/$_MOE_OUT" search=full
  local -a keys=()
  read -r -a keys <<< "$_MOE_KEYS"
  [ "$_MOE_COARSE" = yes ] && search=coarse
  echo "moe-tune: outdir $outdir"
  moe_place || return 2
  if [ "$_MOE_DRY" = yes ]; then moe_dry_run chunk "$_MOE_MODEL" "$_MOE_LAYER" "$search" "$_MOE_CHUNK" "${keys[@]}"; return $?; fi
  if [ -d "$outdir/chunks/$_MOE_CHUNK" ]; then
    echo "moe-tune: chunk $_MOE_CHUNK is recorded, nothing to do"
    return 0
  fi
  cleanup_hook_set moe_cache_clear || return 2
  step_run moe-chunk -- bash "$R9700_ROOT/lib/moe.sh" chunk "$outdir" "$_MOE_MODEL" "$_MOE_CHUNK" "$_MOE_LAYER" "$search" "${keys[@]}" || return $?
  if [ -d "$outdir/chunks/$_MOE_CHUNK" ]; then echo "recorded chunks/$_MOE_CHUNK"; fi # the worker's own lines are in the step's log
}

# moe_ab_body: the body of `supervise` for `ab`: the same order, the A/B as ONE step; the newest record and its decision are printed when it is done
moe_ab_body() {
  local outdir="$R9700_RESULTS_DIR/$_MOE_OUT" stamp
  echo "moe-tune: outdir $outdir"
  moe_place || return 2
  if [ "$_MOE_DRY" = yes ]; then
    moe_dry_run ab "$_MOE_MODEL" "$_MOE_LAYER" "$_MOE_REPS" $_MOE_KEYS
    return $?
  fi
  cleanup_hook_set moe_cache_clear || return 2
  step_run moe-ab -- bash "$R9700_ROOT/lib/moe.sh" ab "$outdir" "$_MOE_MODEL" "$_MOE_LAYER" "$_MOE_RULE" "$_MOE_RULE_KEYS" "$_MOE_REPS" "$_MOE_KEYS" || return $?
  stamp="$(ls "$outdir/ab" 2> /dev/null | grep -v '\.part-' | LC_ALL=C sort | tail -n 1)"
  if [ -n "$stamp" ] && [ -f "$outdir/ab/$stamp/decision.txt" ]; then
    echo "recorded ab/$stamp"
    cat "$outdir/ab/$stamp/decision.txt"
  fi
}

# moe_activate_body: the body of `supervise` for `activate`: no step_run, so no admission, no marker and no cleanup hook; the lock, the restore-first and
# the one cleanup of `supervise` stand around the swap of lib/moe_verb.sh
moe_activate_body() {
  local outdir="$R9700_RESULTS_DIR/$_MOE_OUT"
  echo "moe-tune: outdir $outdir"
  moe_activate_verb "$outdir" "$_MOE_MODEL" "$_MOE_STAMP" "$_MOE_FORCE" "$_MOE_LAYER"
}

# moe_merge_reading: `merge` is a READING verb (no GPU, no admission): like `verdict` it takes the lock only when a marker exists, to restore first
moe_merge_reading() {
  if [ -f "$(marker_path)" ]; then
    lock_take moe-tune || return $?
    restore_first
    lock_release
  fi
  prepare_run || return 2
  echo "moe-tune: outdir $R9700_RESULTS_DIR/$_MOE_OUT"
  moe_merge_verb "$R9700_RESULTS_DIR/$_MOE_OUT" "$_MOE_MODEL" "$_MOE_LAYER" "$_MOE_BASE" "${_MOE_CHUNKS[@]}"
}

# verb_moe_tune chunk|merge|activate|ab <model> [options]: tune a chunk, merge chunks into a record, activate a record (the only step that changes what a
# server reads), A/B the activated file against the default. Typed as `moe-tune`. Every GPU invocation is one supervisor: one lock, restore first, one
# stop of the operator's server, one restore.
verb_moe_tune() {
  moe_tune_args "$@" || exit 2
  case $_MOE_MODE in
    merge) moe_merge_reading ;;
    chunk) supervise moe-tune moe_prepare moe_chunk_body ;;
    ab) supervise moe-tune moe_prepare moe_ab_body ;;
    activate) supervise moe-tune moe_prepare moe_activate_body ;;
  esac
  exit $?
}

main() {
  local verb="${1:-}"
  # a verb is lower-case words joined by `-`; its function has `_` instead (verb_moe_tune is `moe-tune`)
  if [ -z "$verb" ] || [[ ! $verb =~ ^[a-z]+(-[a-z]+)*$ ]] || ! declare -F "verb_${verb//-/_}" > /dev/null; then
    echo "r9700: unknown verb \"$verb\"; legal: $(verb_commands | tr '\n' ' ' | sed 's/ $//')" >&2
    exit 2
  fi
  shift
  "verb_${verb//-/_}" "$@"
}

# run only when executed: tests/test_lifecycle.sh sources this file to call a verb function directly
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
