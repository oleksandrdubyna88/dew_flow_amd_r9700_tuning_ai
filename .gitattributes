# Every text file is LF in the working tree and in the repository, on every platform.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
# Measured data kept byte for byte: bench lines carry trailing spaces, and the verdict tests read exact line numbers.
tests/fixtures/** -text
